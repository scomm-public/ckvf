{
  "name": "@ckvf/node",
  "version": "0.1.0",
  "description": "CKVF Node.js implementation using platform cryptography",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "LICENSE", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/node.test.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "generate-vectors": "npm run build && node dist/generate-vectors.js"
  },
  "dependencies": {
    "@ckvf/core": "0.1.0",
    "hash-wasm": "^4.12.0"
  },
  "devDependencies": {
    "@ckvf/browser": "0.1.0",
    "@noble/curves": "^2.4.0"
  },
  "ckvf": {
    "specification": "draft-0.1",
    "readVersions": ["1.0"],
    "writeVersions": ["1.0"]
  }
}
